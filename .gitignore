.DS_Store
QA-CHECKLIST.md

# schema + policies: keep local, do not serve from a public repo
admin/*.sql

# Generated at deploy by build-pages.mjs, never committed: one 450 kB copy of the
# app per static path would be 7 MB of duplication that goes stale the moment
# index.html changes.
/404.html
/about/
/sell/
/packages/
/we-buy/
/results/
/terms/
/privacy/
/help/
/molders/
/lot/
# Dutch, generated the same way: one translated copy per path.
/nl/

# The two reports build-pages writes after every run. Generated, and they change
# on every build, so they stay out of the history; i18n/nl.json is the file a
# person edits and that one IS tracked.
i18n/untranslated.txt
i18n/unused.txt
/retrobrighting/
/sitemap-lots.xml

# Local safety copies taken before a large edit. Never serve these: the repo
# is public, so a committed .bak is a second copy of the site on the internet.
*.bak
.wrangler/
node_modules/
i18n/js-untranslated.txt
i18n/js-fragments.txt
